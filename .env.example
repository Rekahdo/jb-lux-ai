# ==============================================================================
# JB LUX ENTERPRISES — ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Vite Frontend — accessible in React via import.meta.env)
# NOTE: In Vite, any client-side variable MUST begin with the prefix "VITE_".
# ------------------------------------------------------------------------------

# VITE_APP_URL: The public base URL of the application.
# Used by React Helmet for canonical SEO URLs, Open Graph sharing cards, and Twitter previews.
VITE_APP_URL="https://jbluxai.vercel.app"

# VITE_STORE_NAME: Brand name displayed across navigation, metadata, and receipts.
VITE_STORE_NAME="JB Lux Enterprises"

# VITE_STORE_PHONE: Primary phone line for client concierge displayed in header/footer.
VITE_STORE_PHONE="+234 905 940 5621"

# VITE_STORE_EMAIL: Official customer inquiry and support email.
VITE_STORE_EMAIL="okaforrichard76@gmail.com"

# VITE_WHATSAPP_NUMBER: Lagos Island atelier direct WhatsApp number (international format without + or spaces).
VITE_WHATSAPP_NUMBER="2349059405621"

# VITE_DEFAULT_BANK_NAME: Default store banking institution for manual transfers.
VITE_DEFAULT_BANK_NAME="Opay"

# VITE_DEFAULT_ACCOUNT_NAME: Beneficiary account name for order transfers.
VITE_DEFAULT_ACCOUNT_NAME="Okafor Richard Tochukwu"

# VITE_DEFAULT_ACCOUNT_NUMBER: 10-digit NUBAN account number displayed at checkout.
VITE_DEFAULT_ACCOUNT_NUMBER="9059405621"


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE & NOTIFICATION VARIABLES (Protected — never exposed in frontend bundle)
# ------------------------------------------------------------------------------

# RESEND_API_KEY: API key from Resend (https://resend.com) for real transactional email delivery.
# Required when sending live HTML order confirmation receipts and status update emails.
RESEND_API_KEY="re_your_resend_api_key_here"

# RESEND_FROM_EMAIL: The verified sender email domain on Resend.
# Use "onboarding@resend.dev" for sandbox testing, or your custom domain "orders@jbluxenterprises.com".
RESEND_FROM_EMAIL="JB Lux Orders <onboarding@resend.dev>"

# ADMIN_NOTIFICATION_EMAIL: Email where store staff receives notifications of new uploaded receipts.
ADMIN_NOTIFICATION_EMAIL="okaforrichard76@gmail.com"

# APP_URL: Injected automatically by AI Studio at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
